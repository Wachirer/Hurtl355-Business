# ── Hurtl355 Environment Variables ──────────────────────────────────────────
# Local development: copy this file to .env and fill in your values.
# Production (Render): set these in the Render dashboard instead — never commit .env.

# Long random string. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Local: SQLite file. Production: your Neon connection string, e.g.
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///hurtl355.db

# Used only by seed.py / scripts/set_admin_password.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hurtl355.com
ADMIN_PASSWORD=choose-a-strong-password

RATE_LIMIT_TESTIMONIAL=3

# development locally, production on Render
FLASK_ENV=development
FLASK_DEBUG=1

# ── Cloudflare R2 media storage (leave empty locally to store files on disk) ──
# Needed in production because Render's disk is wiped on every deploy/restart.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
